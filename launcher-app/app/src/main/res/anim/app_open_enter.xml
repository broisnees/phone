<?xml version="1.0" encoding="utf-8"?>
<!-- Opening app scales up + fades in on TOP of the opaque launcher (which holds, below). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="230" />
    <scale android:fromXScale="0.94" android:toXScale="1.0" android:fromYScale="0.94" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="230" />
</set>
